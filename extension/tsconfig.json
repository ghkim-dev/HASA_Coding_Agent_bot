{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // VS Code loads extensions as CommonJS, so this half of the repository is
    // compiled rather than run through Node's type stripping like src/.
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
