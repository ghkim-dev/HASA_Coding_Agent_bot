{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // esbuild produces the CommonJS bundle VS Code loads; tsc's only job here
    // is type checking. "Preserve" is the setting that says so — it stops the
    // compiler reasoning about emit, which is what made importing the ESM
    // `src/` half an error rather than a bundler's problem.
    "module": "Preserve",
    "noEmit": true,
    // `src/` import specifiers carry `.ts`; esbuild resolves them natively.
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
