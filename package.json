{
  "name": "hasa-agent-arena",
  "version": "0.1.0",
  "private": true,
  "description": "HASA Agent Arena \u2014 model runner, isolated workspaces, verifiable evaluator",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "probe": "node --env-file-if-exists=.env src/probe/cli.ts",
    "arena": "node --env-file-if-exists=.env src/cli/main.ts",
    "serve": "node --env-file-if-exists=.env src/server/main.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:fuzz": "node --test \"src/**/*.fuzz.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p extension --noEmit",
    "build:extension": "node extension/build.mjs",
    "watch:extension": "node extension/build.mjs --watch"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.8.3"
  }
}
