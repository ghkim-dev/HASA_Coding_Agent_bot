# TEMPLATE ONLY — this file IS committed. Never put a real key here.
# Copy to .env (gitignored) and fill it in there.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# Required for any real HASA call.
HASA_API_KEY=

# Optional. Defaults to https://open.hasa.re.kr/v1
HASA_BASE_URL=https://open.hasa.re.kr/v1

# Optional. Comma-separated model ids to probe instead of every model
# returned by GET /v1/models. Model ids are NEVER hardcoded in source.
HASA_MODELS=

# Concurrency caps. Global in-flight requests, and per-model in-flight requests.
ARENA_GLOBAL_CONCURRENCY=4
ARENA_MODEL_CONCURRENCY=1

# Orchestrator HTTP server (Phase 1). Bound to loopback only.
ARENA_PORT=7801
ARENA_HOST=127.0.0.1

# Development only. When 1, full prompts/responses are written to the log.
# Prints a warning on boot. Leave unset in normal use.
ARENA_LOG_PROMPTS=
