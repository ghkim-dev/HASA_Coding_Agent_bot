{
  // Without this file F5 has nothing to launch and VS Code falls back to the
  // "Select debugger" picker. The extension lives in a subfolder, so the
  // development path has to be spelled out rather than defaulting to the
  // workspace root.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run HASA Coding Agent",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension"],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "build extension"
    },
    {
      "name": "Orchestrator (server)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server/main.ts",
      "runtimeArgs": ["--env-file-if-exists=.env"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Capability probe (mock)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/probe/cli.ts",
      "args": ["--mock"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--test", "src/**/*.test.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
