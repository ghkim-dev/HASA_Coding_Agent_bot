{
  "version": "2.0.0",
  "tasks": [
    {
      // The extension's `main` points at out/extension.js, which is gitignored
      // and therefore absent on a fresh clone. Running this before F5 means the
      // first launch works rather than failing on a missing entry point.
      "label": "build extension",
      "type": "shell",
      "command": "pnpm",
      "args": ["build:extension"],
      "options": { "cwd": "${workspaceFolder}" },
      // esbuild's output is not tsc's, so there is nothing for $tsc to parse.
      // Type errors are reported by the separate "typecheck" task.
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      // esbuild, not tsc: the extension is bundled now, and `tsc -p extension`
      // is type-check only (noEmit) so watching it would produce nothing.
      "label": "watch extension",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "watch:extension"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "never", "panel": "dedicated" }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "pnpm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "pnpm",
      "args": ["typecheck"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$tsc"]
    }
  ]
}
